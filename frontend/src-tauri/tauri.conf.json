{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PharmaOS",
  "version": "0.1.0",
  "identifier": "in.pharmaos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "PharmaOS", "width": 1280, "height": 800, "minWidth": 1024, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.example.in; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"]
  }
}
