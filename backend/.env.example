# Runtime (app role, subject to RLS)
DATABASE_URL=postgres://pharmacy_app:change-me-in-secret-manager@localhost:5432/pharmaos
# Migrations (owner role)
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pharmaos
PORT=3000
# DEV ONLY. In production use asymmetric keys (EdDSA/RS256) from a secret manager (see T4.1).
JWT_SECRET=dev-only-change-me-at-least-32-characters-long
